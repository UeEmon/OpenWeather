:8080 {
 encode gzip
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  Referrer-Policy strict-origin-when-cross-origin
  -Server
 }
 root * /srv/openweather
 @admin path /collector /collector/ /collector-admin.html /collector-admin.js /api/v1/admin/*
 handle @admin {
  basic_auth {
   {$COLLECTOR_ADMIN_USER:admin} {$COLLECTOR_ADMIN_HASH}
  }
  @adminApi path /api/v1/admin/*
  handle @adminApi {
   reverse_proxy ocean-data:8080
  }
  @adminPage path /collector /collector/
  rewrite @adminPage /collector-admin.html
  file_server
 }
 @publicGet {
  method GET
  path /api/v1/weather /api/v1/marine /api/v1/sst-analysis /api/v1/bathymetry /api/v1/bathymetry-base /api/v1/jma-marine-bulletins /api/v1/jma-typhoon-bulletins /api/v1/areas /api/v1/status /api/v1/sources
 }
 handle @publicGet {
  reverse_proxy ocean-data:8080
 }
 @points {
  method POST
  path /api/v1/points
 }
 handle @points {
  reverse_proxy ocean-data:8080
 }
 @assets path / /index.html /style.css /app.js /weather.mjs /areas.js /gis-terrain.mjs /bathymetry-gis.mjs /browser-settings.mjs /vendor/cesium/*
 handle @assets {
  file_server
 }
 handle {
  respond 404
 }
}
